{
  "name": "NetPulse Cloud (Java 21 + Angular 20 + Docker)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true
    }
  },
  "forwardPorts": [4200, 8080, 5432, 6379],
  "postCreateCommand": "java -version && mvn -version && node -v"
}
