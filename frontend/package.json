{
  "name": "netpulse-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build --configuration production",
    "generate:api": "openapi-generator-cli generate -i ../contracts/netpulse-openapi.yaml -g typescript-angular -o src/app/core/api/generated --additional-properties=ngVersion=20.0.0,providedIn=root"
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@openapitools/openapi-generator-cli": "^2.16.0",
    "typescript": "~5.8.2"
  }
}
